# Plantilla de configuración. No necesitas editarla a mano:
# en la plataforma pulsa «Configurar IA», elige el proveedor y pega tu clave.

# Proveedor de IA: gemini (recomendado), groq u openrouter
AI_PROVIDER=gemini
AI_API_KEY=PEGA_AQUI_TU_CLAVE

# Opcional: forzar un modelo concreto del proveedor
# AI_MODEL=gemini-2.5-flash

PORT=3000
